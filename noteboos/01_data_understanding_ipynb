## 5. Missing values
def missing_report(d):
    miss = d.isna().sum()
    pct = (miss / len(d) * 100).round(2)
    rep = pd.DataFrame({'n_missing': miss, 'pct_missing': pct})
    return rep[rep['n_missing'] > 0].sort_values('pct_missing', ascending=False)

for name, d in datasets.items():
    print(f"--- Missing values: {name} ---")
    rep = missing_report(d)
    if rep.empty:
        print('Không có missing value.')
    else:
        display(rep)
    print()

# Tổng số ô thiếu và số dòng bị ảnh hưởng
n_cells_missing = df.isna().sum().sum()
n_rows_any_missing = df.isna().any(axis=1).sum()
