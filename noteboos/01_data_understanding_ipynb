    print(f"{col}: {(df[col] < 0).sum()} giá trị âm, {(df[col] == 0).sum()} giá trị = 0")
# Outlier theo quy tắc IQR (chỉ để ghi nhận, chưa xử lý)
iqr_rows = []
for col in numeric_cols:
    q1, q3 = df[col].quantile([0.25, 0.75])
    iqr = q3 - q1
    low, high = q1 - 1.5 * iqr, q3 + 1.5 * iqr
    n_out = ((df[col] < low) | (df[col] > high)).sum()
    iqr_rows.append({'column': col, 'lower_bound': low, 'upper_bound': high,
                     'n_outliers': n_out, 'pct_outliers': round(n_out / len(df) * 100, 2)})

pd.DataFrame(iqr_rows).sort_values('n_outliers', ascending=False)
